<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agenda13.Views.Sobre"
             Title="Sobre">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="TekturRegular" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#072246" Offset="0.8" />
            <GradientStop Color="DarkSlateGrey" Offset="0.4" />
            <GradientStop Color="Teal" Offset="0.2" />


        </LinearGradientBrush>
    </ContentPage.Background>
    <VerticalStackLayout Padding="3">
        <Border StrokeShape="RoundRectangle 10, 10, 0, 0"
        BackgroundColor="Teal">
            <VerticalStackLayout Padding="10">

                <Grid ColumnDefinitions="*" RowDefinitions="Auto, Auto">
                    <Label  Grid.Row="0" Grid.Column="0"
                          Text="Desenvolvedor : Daniel Dias"
                          VerticalOptions="Center" 
                          HorizontalOptions="Center" Margin="10" />
                    
                    <Label  Grid.Row="2" Grid.Column="0"
                          Text="Ano de Desenvolvimento : 2026"
                          VerticalOptions="Center" 
                          HorizontalOptions="Center" Margin="10"/>
                   
                </Grid>
                
            </VerticalStackLayout>
        </Border>
        <Image  Source="sobredesenvolvedor.png"
         HeightRequest="380"
         Aspect="AspectFit"  />
        
        <Border StrokeShape="RoundRectangle 0, 0, 10, 10"
        BackgroundColor="#193545">
    <VerticalStackLayout>
        
                <Button Text="Voltar" Clicked="OnButtonClicked" HorizontalOptions="Center" Padding="80, 0, 80 , 0" Margin="20" BackgroundColor="LightBlue" FontFamily="TekturRegular"/>
    </VerticalStackLayout>
</Border>
        
    </VerticalStackLayout>
</ContentPage>