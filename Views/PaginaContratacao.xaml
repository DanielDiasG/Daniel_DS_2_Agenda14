<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Agenda13.Views.PaginaContratacao"
             Title="Contrataçõa Hotel Vista Mar"
             >

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#072246" Offset="0.8" />
            <GradientStop Color="DarkSlateGrey" Offset="0.4" />
            <GradientStop Color="Teal" Offset="0.2" />
  

        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="TekturRegular" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#FFC333" />
            <Setter Property="FontFamily" Value="TekturRegular" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="FontFamily" Value="TekturRegular" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="10">
        <Grid ColumnDefinitions="*,* " RowDefinitions="Auto,Auto">
            <Button Grid.Column="0" Text="Sobre ⓘ "  Clicked="OnButtonClicked" />
            <Button Grid.Column="1"  Text="Suítes" Clicked="BtnSuites" />
        </Grid>

        <Image  Source="bannerhotel.png"
                HeightRequest="185"
                 Aspect="AspectFit" 
                Margin="0,-26,0,-25"
         />
        
        <Border StrokeShape="RoundRectangle 20"
                BackgroundColor="#FFCC66"
                Margin="0,10,0,10">

          <Label Text="Cálculo da Diária"
               FontFamily="TekturMedium"
               TextColor="LightYellow"
               HorizontalTextAlignment="Center"
               FontSize="30"
               Margin="0, 10, 0, 10"
           />
        </Border>

        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="#072246">
            <VerticalStackLayout Padding="10">

                <Grid ColumnDefinitions="*, *, *, *"
                      RowDefinitions="Auto, Auto">

                    <Image Grid.Row="0" Grid.Column="0" Source="adulto.png"
HeightRequest="50"
 Aspect="AspectFit" />
                    <Label Grid.Row="0" Grid.Column="1" Text="Adultos:" />


                    <Label Grid.Row="0" Grid.Column="2" 
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>
                    <Stepper x:Name="stp_adultos" Grid.Row="0" Grid.Column="3"
                             Minimum="1" Maximum="5"/>

                    <Image  Grid.Row="1" Grid.Column="0" Source="crianca.png"
HeightRequest="50"
 Aspect="AspectFit" />
                    <Label Grid.Row="1" Grid.Column="1" Text="Crianças:" />

                    <Label Grid.Row="1" Grid.Column="2" Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}" />
                    <Stepper x:Name="stp_criancas" Grid.Row="1" Grid.Column="3"
                             Minimum="0" Maximum="5"/>
                </Grid>

                <Label Text="Selecione sua Acomodação:"
                       HorizontalTextAlignment="Center"
                       Margin="0, 20, 0, 5"/>
                <Picker  x:Name="pck_quarto" ItemDisplayBinding="{Binding Descricao}" BackgroundColor ="#336666" HorizontalTextAlignment="Center" />
               
                <Border StrokeShape="RoundRectangle 10"
                        BackgroundColor="#003366"
                        Margin="0, 20, 0, 20">

                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="*, *"
                          RowSpacing="10" Padding="10">

                        <Label Grid.Row="0" Grid.Column="0" Text="Data Check-in:" />
                        <DatePicker x:Name="dtpck_checkin" Grid.Row="0" Grid.Column="1" DateSelected="dtpck_checkin_DateSelected"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Data Check-out:" />
                        <DatePicker x:Name="dtpck_checkout" Grid.Row="1" Grid.Column="1" />

                    </Grid>
                </Border>

                <Button Text="Calcular!" Clicked="Button_Clicked" />

            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>

</ContentPage>